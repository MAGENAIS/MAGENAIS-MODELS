{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MAGENAIS/MAGENAIS-MODELS/blob/main/schemas/model-response.schema.json",
  "title": "MAGENAIS Model Response",
  "description": "The normalized shape every MAGENAIS model returns from execute(). Mirrors src/models/types/ModelResponse.ts in the MAGENAIS project, field-for-field. If you change one, change the other.",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "modelId", "modelVersion", "output"],
  "properties": {
    "success": { "type": "boolean" },
    "modelId": { "type": "string" },
    "modelVersion": { "type": "string" },
    "output": {
      "description": "Model-specific result payload. Shape is defined by each model, not by this schema."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "description": "Model-specific supporting data for the result, e.g. perturbation trial counts."
    },
    "explanation": {
      "type": "string",
      "description": "Human-readable explanation of the result."
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": "string" },
        "executionTimeMs": { "type": "number", "minimum": 0 },
        "datasetSize": { "type": "integer", "minimum": 0 },
        "algorithm": { "type": "string" }
      }
    }
  }
}
