{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MAGENAIS/MAGENAIS-MODELS/blob/main/schemas/model-manifest.schema.json",
  "title": "MAGENAIS Model Manifest",
  "description": "The metadata every MAGENAIS model publishes about itself. Mirrors src/models/types/ModelManifest.ts in the MAGENAIS project, field-for-field. If you change one, change the other.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "author",
    "type",
    "capabilities",
    "runtimes",
    "license",
    "pricing",
    "trust"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier, independent of any GitHub URL. Convention: \"magenais.<kebab-case-name>\".",
      "examples": ["magenais.decision-score"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name.",
      "examples": ["DecisionScore"]
    },
    "version": {
      "type": "string",
      "description": "Semantic version of this model, independent of MAGENAIS's own version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "organization": { "type": "string" }
      },
      "additionalProperties": false
    },
    "type": {
      "type": "string",
      "enum": ["algorithm", "ml", "llm", "vision", "audio", "graph", "hybrid"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "runtimes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Runtime ids this model can execute under, e.g. \"builtin-local\", \"api\"."
    },
    "license": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "examples": ["Apache-2.0", "MIT"] },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["free", "paid", "freemium", "enterprise"] }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "string",
      "enum": ["magenais-verified", "community-verified", "experimental", "unverified"]
    },
    "uri": {
      "type": "string",
      "description": "Canonical URI, independent of repository location.",
      "examples": ["magenais://decision-score@1.0.0"]
    },
    "repository": {
      "type": "string",
      "description": "Name of this model's independent GitHub repository, if published.",
      "examples": ["MAGENAIS-MODEL-DECISION-SCORE"]
    },
    "documentation": {
      "type": "string",
      "format": "uri"
    }
  }
}
